{
  "manifest_version": 3,
  "name": "PhishGuard - Email Phishing Detector",
  "version": "1.2.0",
  "description": "Explainable phishing triage engine for emails. Detects phishing automatically in Gmail and Outlook or with 1-click active tab extraction.",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://mail.google.com/*",
    "https://*.outlook.com/*",
    "https://*.office.com/*",
    "https://*.office365.com/*",
    "https://*.live.com/*",
    "https://*.cloud.microsoft/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://*.outlook.com/*",
        "https://*.office.com/*",
        "https://*.office365.com/*",
        "https://*.live.com/*",
        "https://*.cloud.microsoft/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
